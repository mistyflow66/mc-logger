+            alert("密碼錯誤，請重新輸入");
+            localStorage.removeItem('mc_access_key');
+            userKey = "";
+            checkAccess();
+            return;
+          }
+          const setText = (id, v) => { const el = document.getElementById(id); if (el) el.innerText = v || 0; };
+          if (document.getElementById('balanceDisplay')) document.getElementById('balanceDisplay').innerText = data.total3C || 0;
+          const todayList = document.getElementById('todayList');
+          if (todayList) todayList.innerHTML = (data.todayLogs && data.todayLogs.length > 0) ? data.todayLogs.join("<br>") : "今天還沒有紀錄";
+          setText('wakeupCount', data.wakeup || 0);
+          setText('goodCount', data.good || 0);
+          setText('pityCount', data.pityProgress || 0);
+          const noteList = document.getElementById('noteList');
+          if (noteList) noteList.innerHTML = (data.notes && data.notes.length > 0) ? data.notes.join("<br>") : "目前沒有留言";
+          allChestImages = data.myChest || [];
+          renderChest();
+        })
+        .catch(err => console.error("抓取資料失敗:", err));
+    }
+
+    function renderChest() {
+      const gallery = document.getElementById('chestGallery');
+      const controls = document.getElementById('paginationControls');
+      if (!gallery || !controls) return;
+      if (allChestImages.length === 0) {
+        gallery.innerHTML = "<div style='color:#777;font-size:12px;'>寶箱還是空的...</div>";
+        controls.classList.add('hidden');
+        return;
+      }
+      const totalPages = Math.ceil(allChestImages.length / itemsPerPage);
+      if (currentPage > totalPages) currentPage = totalPages;
+      if (currentPage < 1) currentPage = 1;
+      const startIndex = (currentPage - 1) * itemsPerPage;
+      const pageImages = allChestImages.slice(startIndex, startIndex + itemsPerPage);
+      gallery.innerHTML = pageImages.map(url => `
+    <div style="width:100%; aspect-ratio:1/1; display:flex; align-items:center; justify-content:center;">
+      <img src="${url}" referrerpolicy="no-referrer" style="width:90%; height:90%; object-fit:contain; image-rendering:pixelated;">
+    </div>
+  `).join("");
+      if (allChestImages.length > itemsPerPage) {
+        controls.classList.remove('hidden');
+        const pageInfo = document.getElementById('pageInfo');
+        if (pageInfo) pageInfo.innerText = `${currentPage} / ${totalPages}`;
+        const prev = document.getElementById('prevPage');
+        const next = document.getElementById('nextPage');
+        if (prev) prev.disabled = (currentPage === 1);
+        if (next) next.disabled = (currentPage === totalPages);
+      } else {
+        controls.classList.add('hidden');
+      }
+    }
+
+    function changePage(offset) {
+      currentPage += offset;
+      renderChest();
+    }
+
+    function submitForm() {
+      if (!userKey) { checkAccess(); return; }
+
+      const userRadio = document.querySelector('input[name="user"]:checked');
+      const user = (userKey === "guest") ? "guest" : (userRadio ? userRadio.value : "卉");
+
+      const submitBtn = document.querySelector('button[onclick="submitForm()"]') || null;
+
+      if (user === '姐') {
+        const inputPwdEl = document.getElementById('passwordInput');
+        const inputPwd = inputPwdEl ? inputPwdEl.value : "";
+        if (inputPwd !== SUPERVISOR_CODE.toString()) {
+          alert("密碼錯誤！");
+          return;
+        }
+      }
+
+      const typeEl = document.getElementById('typeSelect');
+      const itemEl = document.getElementById('itemSelect');
+      const valEl = document.getElementById('valueInput');
+      const noteEl = document.getElementById('noteInput');
+
+      const type = typeEl ? typeEl.value : "";
+      const item = itemEl ? itemEl.value : "";
+      const valRaw = valEl ? String(valEl.value).trim() : "";
+      const note = noteEl ? noteEl.value.trim() : "";
+
+      if (!type || !item) { alert("請選擇類別和項目！"); return; }
+      const isTextMode = (type === "規劃" || item === "其他");
+      if (!valRaw) {
+        alert(isTextMode ? "請輸入『做了什麼』！" : "請輸入『數量數字』！");
+        return;
+      }
+
+      if (submitBtn) {
+        submitBtn.disabled = true;
+        submitBtn.innerText = "⏳ 傳送中...";
+        submitBtn.style.background = "#95a5a6";
+      }
+
+      const finalVal = isTextMode ? 0 : valRaw;
+      const otherNote = isTextMode ? valRaw : "";
+      const url = `${gasUrl}?action=addData&key=${encodeURIComponent(userKey)}&user=${encodeURIComponent(user)}&category=${encodeURIComponent(type)}&item=${encodeURIComponent(item)}&value=${encodeURIComponent(finalVal)}&otherNote=${encodeURIComponent(otherNote)}&note=${encodeURIComponent(note)}`;
+
+      const giftArea = document.getElementById('giftArea');
+      if (giftArea) giftArea.classList.add('hidden');
+      const luckyGif = document.getElementById('luckyGif');
+      if (luckyGif) luckyGif.src = "";
+
+      fetch(url).then(res => res.text()).then(giftResponse => {
+        const giftUrl = giftResponse.replace(/"/g, "").trim();
+        const isImage = giftUrl.startsWith("http");
+
+        let triggerSlot = false;
+
+        if (user === "姐"|| user === "guest") {
+          triggerSlot = true;
+        } else if (user === "卉"  && type === "運動") {
+          if (Math.random() < 0.5) triggerSlot = true;
+        }
+
+        alert("🍎 發現掉落物！");
+
+        if (triggerSlot) {
+          openSlotModal();
+        } else {
+          if (isImage) {
+            if (giftArea) {
+              if (giftUrl.toLowerCase().includes('.png')) {
+                giftArea.innerHTML = `<div style="color:#ffeb3b;">🍎 發現掉落物！</div><div class="img-wrapper"></div>`;
+                const wrapper = giftArea.querySelector('.img-wrapper');
+                if (wrapper) {
+                  const img = new Image();
+                  img.referrerPolicy = "no-referrer";
+                  img.src = `${giftUrl}?v=${new Date().getTime()}`;
+                  img.className = 'chest-img';
+                  img.style.width = '90%';
+                  img.style.height = '90%';
+                  img.onload = () => {
+                    wrapper.appendChild(img);
+                    addPixelParticles(wrapper);
+                  };
+                }
+              } else {
+                giftArea.innerHTML = `<div style="color:#ffeb3b;">🍎 發現掉落物！</div><img id="luckyGif" src="${giftUrl}" style="width:100%; border-radius:8px; object-fit:contain;">`;
+              }
+              giftArea.classList.remove('hidden');
+            }
+          } else {
+            openSlotModal();
+          }
+        }
+
+        clearFormAfterSubmit();
+        refreshData();
+      }).catch(err => {
+        console.error("提交失敗:", err);
+        alert("連線失敗，請檢查網路");
+      }).finally(() => {
+        if (submitBtn) {
+          submitBtn.disabled = false;
+          submitBtn.innerText = "💾 存檔紀錄";
+          submitBtn.style.background = "var(--mc-green)";
+        }
+      });
+    }
+
+    function clearFormAfterSubmit() {
+      const typeSelect = document.getElementById('typeSelect');
+      const itemSelect = document.getElementById('itemSelect');
+      const valInput = document.getElementById('valueInput');
+      const noteInput = document.getElementById('noteInput');
+      if (typeSelect) typeSelect.value = "";
+      if (itemSelect) itemSelect.innerHTML = '<option value="">-- 選擇項目 --</option>';
+      if (valInput) valInput.value = "";
+      if (noteInput) noteInput.value = "";
+      setRandomPlaceholder();
+    }
+
+    function toggleChest() {
+      const wrapper = document.getElementById('chestWrapper');
+      if (wrapper) wrapper.classList.toggle('hidden');
+    }
+
+    function openSlotModal() {
+      const slotFrame = document.getElementById('slotFrame');
+      if (slotFrame) slotFrame.src = "slot.html";
+      const modal = document.getElementById('slotModal');
+      if (modal) modal.style.display = 'flex';
+    }
+
+    function closeSlotModal() {
+      const modal = document.getElementById('slotModal');
+      if (modal) modal.style.display = 'none';
+    }
+
+    function addPixelParticles(wrapper) {
+      for (let i = 0; i < 40; i++) {
+        const span = document.createElement('span');
+        span.className = 'pixel-particle';
+        span.style.top = Math.random() * 100 + '%';
+        span.style.left = Math.random() * 100 + '%';
+        span.style.animationDuration = (Math.random() * 2 + 3) + 's';
+        span.style.animationDelay = Math.random() * 4 + 's';
+        const colors = ['#FFD700', '#FFFFFF', '#ADD8E6'];
+        span.style.background = colors[Math.floor(Math.random() * colors.length)];
+        wrapper.appendChild(span);
+      }
+    }
+
+    window.addEventListener('message', function(e) {
+      if (e.data === 'closeModal') {
+        closeSlotModal();
+        return;
+      }
+
+      const userRadio = document.querySelector('input[name="user"]:checked');
+      const currentUser = (userKey === "guest") ? "guest" : (userRadio ? userRadio.value : "卉");
+
+      const now = new Date();
+      const timeStr = `${now.getHours()}:${now.getMinutes().toString().padStart(2,'0')}`;
+
+      let logMsg = "";
+      let bonusValue = 0;
+      let bonusColor = "";
+      let isFail = false;
+
+      if (e.data === 'win') {
+        logMsg = `🏆 完美合成！(+1分)`;
+        bonusValue = 1;
+        bonusColor = "#FFD700";
+      } else if (e.data === 'near') {
+        logMsg = `✨ 還差一點！(+0.5分)`;
+        bonusValue = 0.5;
+        bonusColor = "#FFA500";
+      } else if (e.data === 'lose') {
+        logMsg = `⛏️ 挖掘失敗`;
+        bonusValue = 0;
+        bonusColor = "#dfe6e9";
+        isFail = true;
+      }
+
+      if (logMsg) {
+        const todayList = document.getElementById('todayList');
+        if (!todayList) return;
+        const currentLogs = (todayList.innerHTML === "今天還沒有紀錄") ? "" : todayList.innerHTML;
+        todayList.innerHTML = `<div style="color:${bonusColor}; border-left: 3px solid ${bonusColor}; padding-left: 8px; margin-bottom: 5px; font-weight: bold;">${timeStr} [${currentUser}] ${logMsg}</div>` + currentLogs;
+
+        if (userKey && (currentUser === "卉" || currentUser === "guest") && (bonusValue > 0 || isFail)) {
+          const itemText = isFail ? "抽獎失敗" : "抽獎";
+          const finalVal = isFail ? 1 : bonusValue;
+          const note = encodeURIComponent(`自動紀錄：${logMsg}`);
+
+          const saveUrl = `${gasUrl}?action=addData&key=${encodeURIComponent(userKey)}&user=${encodeURIComponent(currentUser)}&category=獎勵&item=${encodeURIComponent(itemText)}&value=${encodeURIComponent(finalVal)}&otherNote=&note=${note}`;
+
+          fetch(saveUrl).then(res => res.text()).then(() => {
+            console.log("抽獎結果已同步");
+            fetch(`${gasUrl}?action=readData&key=${encodeURIComponent(userKey)}`)
+              .then(res => res.json())
+              .then(data => {
+                const balanceEl = document.getElementById('balanceDisplay');
+                if (balanceEl) balanceEl.innerText = data.total3C;
+                const pityEl = document.getElementById('pityCount');
+                if (pityEl) pityEl.innerText = data.pityProgress;
+
+                if (isFail && data.pityProgress === 0) {
+                  setTimeout(() => {
+                    if (confirm("✨ 幸運值已滿！獲得一次保底抽獎機會，是否立即使用？")) {
+                      const slotFrame = document.getElementById('slotFrame');
+                      if (slotFrame) slotFrame.src = "slot.html?mode=pity";
+                      const slotModal = document.getElementById('slotModal');
+                      if (slotModal) slotModal.style.display = 'flex';
+                    }
+                  }, 500);
+                }
+              });
+          });
+        }
+      }
+    }, false);
+
+    // 初始化 single onload
+    window.onload = () => {
+      const isGuest = (userKey === "guest");
+      updateTimer();
+      setRandomPlaceholder();
+      setInterval(updateTimer, 60000);
+
+      if (isGuest) {
+        const userSelectDiv = document.querySelector('.user-select');
+        if (userSelectDiv) {
+          userSelectDiv.innerHTML = "<span>角色: 訪客冒險者 (Guest)</span>";
+        }
+        if (!sessionStorage.getItem('guest_welcomed')) {
+          setTimeout(showGuestWelcome, 500);
+          sessionStorage.setItem('guest_welcomed', 'true');
+        }
+      }
+
+      switchUser(isGuest ? 'guest' : '卉');
+
+      if (userKey) {
+        refreshData();
+      } else {
+        checkAccess();
+      }
+    };
+
+function showGuestWelcome() {
+    alert(
+      "🎮 歡迎來到麥塊冒險【訪客模式】\n" +
+      "━━━━━━━━━━━━━━━━\n" +
+      "✨ 模式特點：\n" +
+      "● 快速體驗：套用正式版的完整運動與 3C 換算功能。\n" +
+      "● 共享紀錄：此模式為公開體驗，所有訪客將共同累積能量！\n" + // 改成共享紀錄
+      "\n" +
+      "🎁 冒險提示：\n" +
+      "● 幸運加持：訪客模式下，每次存檔紀錄【保證觸發】掉落物抽獎！\n" + // 改成保證觸發
+      "● 隱藏彩蛋：連續點擊上方「🔋 3C 能量」區域 5 下，可開啟 Creeper 小遊戲！\n" +
+      "━━━━━━━━━━━━━━━━\n" +
+      "祝你冒險愉快！"
+      );
+    }
+  </script>
+</body>
+</html>
