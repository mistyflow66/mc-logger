+      userKey = inputKey;
+      localStorage.setItem('mc_access_key', userKey);
+      location.reload();
+    }
+
+    function switchUser(user) {
+      const actualUser = (userKey === "guest") ? "guest" : user;
+      const pwdArea = document.getElementById('passwordArea');
+      if (pwdArea) pwdArea.classList.toggle('hidden', actualUser !== '姐');
+
+      const typeSelect = document.getElementById('typeSelect');
+      if (!typeSelect) return;
+      typeSelect.innerHTML = '<option value="">-- 選擇類別 --</option>';
+
+      const templateUser = (actualUser === "guest") ? "卉" : actualUser;
+
+      if (optionsMap[templateUser]) {
+        Object.keys(optionsMap[templateUser]).forEach(t => {
+          typeSelect.add(new Option(t, t));
+        });
+      }
+      updateItems();
+    }
+
+    function updateItems() {
+      const userRadio = document.querySelector('input[name="user"]:checked');
+      const user = (userKey === "guest") ? "guest" : (userRadio ? userRadio.value : "卉");
+
+      const type = document.getElementById('typeSelect') ? document.getElementById('typeSelect').value : "";
+      const itemSelect = document.getElementById('itemSelect');
+      if (!itemSelect) return;
+      itemSelect.innerHTML = '<option value="">-- 選擇項目 --</option>';
+
+      const templateUser = (user === "guest") ? "卉" : user;
+
+      if (optionsMap[templateUser] && optionsMap[templateUser][type]) {
+        optionsMap[templateUser][type].forEach(i => itemSelect.add(new Option(i, i)));
+      }
+      checkValueType();
+    }
+
+    function checkValueType() {
+      const typeEl = document.getElementById('typeSelect');
+      const itemEl = document.getElementById('itemSelect');
+      const valInput = document.getElementById('valueInput');
+      if (!valInput) return;
+      const type = typeEl ? typeEl.value : "";
+      const item = itemEl ? itemEl.value : "";
+      if (type === "規劃" || item === "其他") {
+        valInput.type = "text";
+        valInput.placeholder = "做了什麼？";
+      } else {
+        valInput.type = "number";
+        valInput.placeholder = "輸入數量(數字)";
+      }
+    }
+
+    function refreshData() {
+      if (!userKey) { checkAccess(); return; }
+      fetch(`${gasUrl}?action=readData&key=${encodeURIComponent(userKey)}`)
+        .then(res => res.json())
+        .then(data => {
